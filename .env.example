# =============================================================================
# nexo-ai — plantilla de variables de entorno
# Copiar a .env y completar los valores reales (nunca versionar .env).
# Todos los valores aquí son placeholders; ninguno es un secreto real.
# =============================================================================

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
APP_ENV=development
PUBLIC_BASE_URL=http://localhost:8000
WEB_ORIGIN=http://localhost:3000
LOG_LEVEL=INFO

# `fake` usa el orquestador HTTP mínimo. `real` carga el grafo multiagente.
ORCHESTRATOR_PROFILE=fake

# ---------------------------------------------------------------------------
# Base de datos
# Usar el dialecto async (postgresql+asyncpg://).
# IMPORTANTE: URL-encodear caracteres especiales de la contraseña porque
# python-dotenv interpola '$' como variable. Ej.: '$' -> '%24', '@' -> '%40'.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://nexo:nexo@localhost:5432/nexo_dev

# ---------------------------------------------------------------------------
# Supabase (nuevo sistema de API keys: publishable/secret + JWKS)
#   SUPABASE_PUBLISHABLE_KEY / NEXT_PUBLIC_* -> frontend Next.js (apps/web).
#   SUPABASE_SECRET_KEY -> backend (bypassa RLS; NUNCA real aquí ni en frontend).
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_JWKS_URL=https://your-project-ref.supabase.co/auth/v1/.well-known/jwks.json
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Auth: la emisión/validación de tokens la maneja Supabase Auth (ver bloque
# Supabase abajo: JWKS + secret key). El backend NO usa un secreto JWT propio.

# ---------------------------------------------------------------------------
# Modelos. Con ORCHESTRATOR_PROFILE=real, una GEMINI_API_KEY no vacía activa
# automáticamente Gemini; sin ella se conserva el perfil offline.
# La clave se crea en Google AI Studio y nunca debe versionarse.
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Twilio (nunca poner valores reales aquí)
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_SENDER=whatsapp:+14155238886
TWILIO_WEBHOOK_BASE_URL=https://your-demo-url.example.com

# ---------------------------------------------------------------------------
# ElevenLabs (canal de voz — Conversational AI)
#   NEXT_PUBLIC_ELEVENLABS_AGENT_ID -> id PÚBLICO del agente (frontend Next.js).
#   ELEVENLABS_API_KEY -> secreto de backend (signed URLs, webhooks); no versionar.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=agent_xxxxxxxxxxxxxxxxxxxxxxxxxx
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# OpenTelemetry (Pro — dejar vacío en local si no se usa)
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=

# Execution of in-process MVP runs and SSE
RUN_SHUTDOWN_GRACE_SECONDS=15
VOICE_TURN_TIMEOUT_SECONDS=20
SSE_POLL_INTERVAL_MS=500
SSE_KEEPALIVE_SECONDS=15
IDEMPOTENCY_PROCESSING_TTL_SECONDS=300
