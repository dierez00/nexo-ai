{
  "$id": "https://nexo.local/contracts/v1/model_capabilities.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Lo que un modelo puede hacer, en términos que el router entiende.",
  "properties": {
    "allows_sensitive_data": {
      "default": false,
      "description": "Si la política de datos permite enviarle contenido sensible.",
      "title": "Allows Sensitive Data",
      "type": "boolean"
    },
    "cost_per_1k_input_usd": {
      "minimum": 0.0,
      "title": "Cost Per 1K Input Usd",
      "type": "number"
    },
    "cost_per_1k_output_usd": {
      "minimum": 0.0,
      "title": "Cost Per 1K Output Usd",
      "type": "number"
    },
    "max_context_tokens": {
      "maximum": 10000000,
      "minimum": 1,
      "title": "Max Context Tokens",
      "type": "integer"
    },
    "max_output_tokens": {
      "maximum": 1000000,
      "minimum": 1,
      "title": "Max Output Tokens",
      "type": "integer"
    },
    "supports_structured_output": {
      "default": false,
      "title": "Supports Structured Output",
      "type": "boolean"
    },
    "supports_vision": {
      "default": false,
      "title": "Supports Vision",
      "type": "boolean"
    }
  },
  "required": [
    "max_context_tokens",
    "max_output_tokens",
    "cost_per_1k_input_usd",
    "cost_per_1k_output_usd"
  ],
  "title": "ModelCapabilities",
  "type": "object"
}
