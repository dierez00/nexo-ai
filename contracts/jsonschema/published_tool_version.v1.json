{
  "$defs": {
    "Domain": {
      "description": "Los cinco namespaces iniciales (§2.3). Un dominio fuera de esta lista se rechaza.",
      "enum": [
        "vehiculos",
        "ayuntamiento_empresas",
        "registro_civil",
        "salud",
        "ganaderia"
      ],
      "title": "Domain",
      "type": "string"
    },
    "IntegrationState": {
      "description": "Ciclo de vida del MCP Mapper (`DIE-F3-011`).\n\nSe congela en Fase 0 aunque el Mapper sea trabajo de Fase 3: los estados\nforman parte de los contratos de §5.4 y no deben renegociarse después.",
      "enum": [
        "draft",
        "parsed",
        "validated",
        "tested",
        "approved",
        "published",
        "deprecated",
        "rejected"
      ],
      "title": "IntegrationState",
      "type": "string"
    },
    "RiskLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "RiskLevel",
      "type": "string"
    },
    "ToolMetadata": {
      "additionalProperties": false,
      "description": "Descriptor versionado de una tool (§5.4).\n\nLos valores por defecto niegan: modo lectura, riesgo bajo, sin roles\npermitidos. Una tool mal declarada no es invocable por nadie (`DIE-F0-032`).",
      "properties": {
        "allowed_roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Allowed Roles",
          "type": "array"
        },
        "description": {
          "default": "",
          "maxLength": 500,
          "title": "Description",
          "type": "string"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "input_schema_ref": {
          "description": "Referencia inmutable a un JSON Schema publicado en `contracts`.",
          "maxLength": 300,
          "pattern": "^contracts://[a-z0-9_\\-./]+\\.v\\d+$",
          "title": "Input Schema Ref",
          "type": "string"
        },
        "is_mock": {
          "default": true,
          "title": "Is Mock",
          "type": "boolean"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 5,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "mode": {
          "$ref": "#/$defs/ToolMode",
          "default": "read"
        },
        "name": {
          "description": "Nombre `dominio.verbo_objeto`, por ejemplo 'vehiculos.reservar_cita'.",
          "maxLength": 95,
          "title": "Name",
          "type": "string"
        },
        "output_schema_ref": {
          "description": "Referencia inmutable a un JSON Schema publicado en `contracts`.",
          "maxLength": 300,
          "pattern": "^contracts://[a-z0-9_\\-./]+\\.v\\d+$",
          "title": "Output Schema Ref",
          "type": "string"
        },
        "requires_confirmation": {
          "default": false,
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "requires_idempotency_key": {
          "default": false,
          "title": "Requires Idempotency Key",
          "type": "boolean"
        },
        "risk": {
          "$ref": "#/$defs/RiskLevel",
          "default": "low"
        },
        "timeout_ms": {
          "default": 5000,
          "maximum": 3600000,
          "minimum": 0,
          "title": "Timeout Ms",
          "type": "integer"
        },
        "version": {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "domain",
        "input_schema_ref",
        "output_schema_ref"
      ],
      "title": "ToolMetadata",
      "type": "object"
    },
    "ToolMode": {
      "description": "Modo de una tool. Solo `WRITE` puede producir efectos externos.",
      "enum": [
        "read",
        "write",
        "compute"
      ],
      "title": "ToolMode",
      "type": "string"
    }
  },
  "$id": "https://nexo.local/contracts/v1/published_tool_version.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Versión inmutable publicada en el registry (§5.4).",
  "properties": {
    "approved_by": {
      "maxLength": 67,
      "minLength": 5,
      "title": "Approved By",
      "type": "string"
    },
    "integration_id": {
      "maxLength": 68,
      "minLength": 6,
      "title": "Integration Id",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/ToolMetadata"
    },
    "published_at": {
      "format": "date-time",
      "title": "Published At",
      "type": "string"
    },
    "state": {
      "$ref": "#/$defs/IntegrationState",
      "default": "published"
    },
    "supersedes": {
      "anyOf": [
        {
          "pattern": "^\\d+\\.\\d+\\.\\d+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Supersedes"
    }
  },
  "required": [
    "integration_id",
    "metadata",
    "published_at",
    "approved_by"
  ],
  "title": "PublishedToolVersion",
  "type": "object"
}
