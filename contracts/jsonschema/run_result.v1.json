          "title": "Supporting Tool Call Id"
        },
        "value": {
          "$ref": "#/$defs/FactValue"
        },
        "verification": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "write_eligible": {
          "default": false,
          "title": "Write Eligible",
          "type": "boolean"
        }
      },
      "required": [
