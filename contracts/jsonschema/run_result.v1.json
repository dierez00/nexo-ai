          "type": "array"
        },
        "domain": {
          "$ref": "#/$defs/Domain"
        },
        "fact_id": {
          "maxLength": 68,
          "minLength": 6,
          "title": "Fact Id",
          "type": "string"
        },
        "reason": {
          "description": "Motivo estable de la decisión. Ejemplo: 'source_expired'.",
          "maxLength": 300,
          "title": "Reason",
          "type": "string"
