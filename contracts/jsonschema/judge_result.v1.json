{
  "$defs": {
    "JudgeScores": {
      "additionalProperties": false,
      "description": "Rúbrica versionada, toda en [0, 1].",
      "properties": {
        "a2ui_quality": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "A2Ui Quality",
          "type": "number"
        },
        "clarity": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Clarity",
          "type": "number"
        },
        "completeness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Completeness",
          "type": "number"
        },
        "domain_accuracy": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Domain Accuracy",
          "type": "number"
        },
        "faithfulness": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Faithfulness",
          "type": "number"
        },
        "permission_compliance": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Permission Compliance",
          "type": "number"
        },
        "tool_selection": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Tool Selection",
          "type": "number"
        }
      },
      "required": [
        "domain_accuracy",
        "tool_selection",
        "faithfulness",
        "completeness",
        "clarity",
        "a2ui_quality",
        "permission_compliance"
      ],
      "title": "JudgeScores",
      "type": "object"
    }
  },
  "$id": "https://nexo.local/contracts/v1/judge_result.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Salida tipada del judge (§5.6). Es un dato analítico, nunca una autorización.",
  "properties": {
    "evaluated_at": {
      "format": "date-time",
      "title": "Evaluated At",
      "type": "string"
    },
    "evaluation_id": {
      "maxLength": 68,
      "minLength": 6,
      "title": "Evaluation Id",
      "type": "string"
    },
    "evidence": {
      "default": "",
      "maxLength": 2000,
      "title": "Evidence",
      "type": "string"
    },
    "generator_model": {
      "description": "Alias lógico como 'high_accuracy' o 'structured_small'.",
      "pattern": "^[a-z][a-z0-9_]{2,40}$",
      "title": "Generator Model",
      "type": "string"
    },
    "judge_model": {
      "description": "Alias lógico como 'high_accuracy' o 'structured_small'.",
      "pattern": "^[a-z][a-z0-9_]{2,40}$",
      "title": "Judge Model",
      "type": "string"
    },
    "passed": {
      "title": "Passed",
      "type": "boolean"
    },
    "rubric_version": {
      "maxLength": 60,
      "title": "Rubric Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 67,
      "minLength": 5,
      "title": "Run Id",
      "type": "string"
    },
    "scores": {
      "$ref": "#/$defs/JudgeScores"
    },
    "unsupported_claims": {
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "title": "Unsupported Claims",
      "type": "array"
    }
  },
  "required": [
    "evaluation_id",
    "run_id",
    "rubric_version",
    "generator_model",
    "judge_model",
    "scores",
    "passed",
    "evaluated_at"
  ],
  "title": "JudgeResult",
  "type": "object"
}
