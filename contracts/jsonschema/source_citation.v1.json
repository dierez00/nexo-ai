{
  "$id": "https://nexo.local/contracts/v1/source_citation.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Referencia puntual a un fragmento de una fuente (§5.2).\n\nEs inmutable a propósito: una citación es evidencia, y la evidencia no se\nedita después de recogerse.",
  "properties": {
    "char_end": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Char End"
    },
    "char_start": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Inicio del tramo relevante dentro del fragmento.",
      "title": "Char Start"
    },
    "corpus_version": {
      "description": "Versión de corpus vigente cuando se recuperó el fragmento.",
      "maxLength": 120,
      "title": "Corpus Version",
      "type": "string"
    },
    "fragment_id": {
      "maxLength": 68,
      "minLength": 6,
      "title": "Fragment Id",
      "type": "string"
    },
    "is_active": {
      "default": true,
      "description": "Falso si la fuente fue sustituida o venció; bloquea claims críticos.",
      "title": "Is Active",
      "type": "boolean"
    },
    "source_id": {
      "maxLength": 67,
      "minLength": 5,
      "title": "Source Id",
      "type": "string"
    },
    "source_version": {
      "maxLength": 40,
      "title": "Source Version",
      "type": "string"
    },
    "valid_from": {
      "format": "date",
      "title": "Valid From",
      "type": "string"
    },
    "valid_to": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Valid To"
    }
  },
  "required": [
    "source_id",
    "fragment_id",
    "corpus_version",
    "source_version",
    "valid_from"
  ],
  "title": "SourceCitation",
  "type": "object"
}
