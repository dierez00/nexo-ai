{
  "info": {
    "_postman_id": "7f5f2a3e-6f4a-4f0c-9e1b-1f5fb0f8c001",
    "name": "Nexo IA API",
    "description": "Colección para probar la API de Nexo IA. Inicia la API en http://localhost:8000 y configura las variables de colección antes de usar los endpoints protegidos.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "email", "value": "" },
    { "key": "password", "value": "" },
    { "key": "access_token", "value": "" },
    { "key": "conversation_id", "value": "conv_7" },
    { "key": "run_id", "value": "run_42" },
    { "key": "action_id", "value": "act_5" },
    { "key": "idempotency_key", "value": "postman-{{$guid}}" },
    { "key": "branch_id", "value": "1" },
    { "key": "module_code", "value": "vehiculos" },
    { "key": "appointment_date", "value": "2026-08-15" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Live",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/health/live" }
        },
        {
          "name": "Ready",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/health/ready" }
        },
        {
          "name": "OpenAPI JSON",
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/openapi.json" }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const body = pm.response.json();",
                  "  if (body.tokens && body.tokens.access_token) {",
                  "    pm.collectionVariables.set('access_token', body.tokens.access_token);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/v1/auth/login"
          }
        },
        {
          "name": "Current user",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/api/v1/users/me"
          }
        }
      ]
    },
    {
      "name": "Conversations",
      "item": [
        {
          "name": "Create conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.conversation_id) pm.collectionVariables.set('conversation_id', body.conversation_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"channel\": \"web\",\n  \"title\": \"Prueba desde Postman\"\n}" },
            "url": "{{base_url}}/api/v1/conversations"
          }
        },
        {
          "name": "Send message",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 202) {",
                  "  const body = pm.response.json();",
                  "  if (body.run_id) pm.collectionVariables.set('run_id', body.run_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"content\": \"Hola, quiero iniciar un trámite\"\n}" },
            "url": "{{base_url}}/api/v1/conversations/{{conversation_id}}/messages"
          }
        }
      ]
    },
    {
      "name": "Runs",
      "item": [
        {
          "name": "Run snapshot",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/api/v1/runs/{{run_id}}"
          }
        },
        {
          "name": "Run events list",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/events/list"
          }
        },
        {
          "name": "Run events SSE",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/event-stream" }],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/api/v1/runs/{{run_id}}/events"
          }
        }
      ]
    },
    {
      "name": "Appointments",
      "item": [
        {
          "name": "Availability",
          "request": {
            "method": "GET",
            "header": [],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "url": "{{base_url}}/api/v1/appointments/availability?branch_id={{branch_id}}&module_code={{module_code}}&date={{appointment_date}}"
          }
        },
        {
          "name": "Create appointment hold",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"branch_id\": 1,\n  \"module_code\": \"vehiculos\",\n  \"service_name\": \"Renovación de licencia\",\n  \"starts_at\": \"2026-08-15T10:00:00Z\",\n  \"ends_at\": \"2026-08-15T10:30:00Z\"\n}" },
            "url": "{{base_url}}/api/v1/appointments/holds"
          }
        }
      ]
    },
    {
      "name": "Actions",
      "item": [
        {
          "name": "Confirm action",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{idempotency_key}}" }
            ],
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] },
            "body": { "mode": "raw", "raw": "{\n  \"consent\": true,\n  \"expected_version\": 1\n}" },
            "url": "{{base_url}}/api/v1/actions/{{action_id}}/confirm"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Metrics",
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] }, "url": "{{base_url}}/api/v1/admin/metrics" }
        },
        {
          "name": "Catalog",
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] }, "url": "{{base_url}}/api/v1/admin/catalog" }
        },
        {
          "name": "Config",
          "request": { "method": "GET", "header": [], "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }] }, "url": "{{base_url}}/api/v1/admin/config" }
        }
      ]
    },
    {
      "name": "Webhooks",
      "item": [
        {
          "name": "WhatsApp incoming",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [ { "key": "From", "value": "whatsapp:+5215555555555", "type": "text" }, { "key": "Body", "value": "Hola desde Postman", "type": "text" }, { "key": "MessageSid", "value": "SM{{$guid}}", "type": "text" } ] },
            "url": "{{base_url}}/whatsapp"
          }
        },
        {
          "name": "WhatsApp status callback",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": { "mode": "urlencoded", "urlencoded": [ { "key": "MessageSid", "value": "SM{{$guid}}", "type": "text" }, { "key": "MessageStatus", "value": "delivered", "type": "text" } ] },
            "url": "{{base_url}}/status"
          }
        }
      ]
    }
  ]
}
